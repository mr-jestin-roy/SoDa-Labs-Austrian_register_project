    ]
  },
  {
    "batch": "09",
    "cells": [
      "col1_sec09.png"
    ],
    "grid_layout": "1x1",
    "grid_image": "grid_09.png",
    "data": {
      "raw": "<div data-bbox=\"265 96 967 770\" data-label=\"Text\"><p><b>Zell am See.</b> Schöne Bergstadt, 758 m hoch<br/>gelegen, Seilschwebebahn auf die 2000 m hohe<br/>Schmittenhöhe. Schwimmen, Segeln und Ten-<br/>nissport. Wintersportzentrum in Salzburg,<br/>alle Wintersportmöglichkeiten. Schöne Hotels<br/>am See gelegen.</p></div><div data-bbox=\"267 786 965 899\" data-label=\"Text\"><p>Auskünfte: Kurverwaltung, Fernsprecher <b>100</b></p></div>",
      "cells": [
        "col1_sec09.png"
      ]
    }
  },
  {
