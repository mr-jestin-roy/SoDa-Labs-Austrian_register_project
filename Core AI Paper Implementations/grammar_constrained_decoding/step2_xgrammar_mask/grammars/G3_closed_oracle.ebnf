# G3 CLOSED ORACLE (leaks the answer; upper bound / proof the mask is applied):
# header = a Pernegg region string; every entry line must be exactly one of the reference entries
# `Phone_Number raw_transcribed_text` from pernegg_rows.csv.
root ::= header entry{1,20}
header ::= region "\n"
region ::= "Pernegg b. Hötzelndorf(Niederdonau)"
    | "Pernegg (Steiermark)"
    | "Pernegg (steiermark)"
entry ::= ref "\n"
ref ::= "1 NSDAP., Ortsgruppenleitung, 4"
